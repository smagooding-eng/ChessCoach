// ChessScout.net on Cloudflare Workers. Build first (Cloudflare's build settings):
//   pnpm install && pnpm run typecheck && pnpm --filter @workspace/chess-coach run build
// then deploy from the repo root:
//   npx wrangler deploy --config cloudflare/wrangler.jsonc
// Build variables (same values as on Vercel): VITE_API_URL, VITE_STRIPE_PUBLISHABLE_KEY.
// Worker secret: STRIPE_SECRET_KEY (npx wrangler secret put STRIPE_SECRET_KEY --config cloudflare/wrangler.jsonc).
{
  "name": "chesscoach1",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../artifacts/chess-coach/dist/public",
    "binding": "ASSETS",
    // App routes that aren't files get index.html (Vercel's "/(.*) -> /index.html").
    "not_found_handling": "single-page-application",
    // The Worker runs first for page addresses (it handles redirects, SEO pages and
    // link previews, then hands everything else to the app). The asset folders below
    // skip it entirely, so the app's files stay free and unlimited. (Cloudflare allows
    // at most 100 rules here, so it's "everything except", not a list of pages.)
    "run_worker_first": [
      "/*",
      "!/assets/*", "!/avatars/*", "!/boards/*", "!/chessscout/*", "!/icons/*", "!/images/*",
      "!/photo/*", "!/pieces/*", "!/shots/*", "!/three-decoders/*"
    ]
  },
  "vars": { "API_URL": "https://chesscoach-api-kbf8.onrender.com" },
  "observability": { "enabled": true }
}
