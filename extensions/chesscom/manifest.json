{
  "manifest_version": 3,
  "name": "ChessScout: Free Game Review for Chess.com",
  "short_name": "ChessScout",
  "version": "1.0.1",
  "description": "When your Chess.com game ends, one click opens a free move-by-move review on ChessScout.net. Never shows during a game.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ChessScout", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [
    { "matches": ["https://www.chess.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon-48.png"], "matches": ["https://www.chess.com/*"] }
  ]
}
