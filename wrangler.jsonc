// ChessScout.net on Cloudflare Workers (Workers Builds reads this file from the repo root;
// cloudflare/wrangler.jsonc is the same setup for deploys run from that folder).
// Deploy: npx wrangler deploy   (builds the site first via cloudflare/build.sh)
// Build variable still needed in Cloudflare: VITE_STRIPE_PUBLISHABLE_KEY (embedded checkout).
// Worker secret: STRIPE_SECRET_KEY (npx wrangler secret put STRIPE_SECRET_KEY).
{
  "name": "chesscoach1",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // builds the site first (skipped when Cloudflare's build step already did)
  "build": { "command": "sh cloudflare/build.sh" },
  "assets": {
    "directory": "artifacts/chess-coach/dist/public",
    "binding": "ASSETS",
    // App routes that aren't files get index.html (Vercel's "/(.*) -> /index.html").
    "not_found_handling": "single-page-application",
    // The Worker runs first for page addresses (it handles redirects, SEO pages and
    // link previews, then hands everything else to the app). The asset folders below
    // skip it entirely, so the app's files stay free and unlimited. (Cloudflare allows
    // at most 100 rules here, so it's "everything except", not a list of pages.)
    "run_worker_first": [
      "/*",
      "!/assets/*", "!/avatars/*", "!/boards/*", "!/chessscout/*", "!/icons/*", "!/images/*",
      "!/photo/*", "!/pieces/*", "!/shots/*", "!/three-decoders/*"
    ]
  },
  "vars": { "API_URL": "https://chesscoach-api-kbf8.onrender.com" },
  // Uptime alerts every minute (cloudflare/api/monitor.ts). Needs the NTFY_TOPIC secret to send anything.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
