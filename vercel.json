{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run typecheck && pnpm --filter @workspace/chess-coach run build",
  "outputDirectory": "artifacts/chess-coach/dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/blog/:slug",
      "destination": "/learn/:slug",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/:l([a-z0-9])",
      "destination": "/?utm_source=heycatch&utm_campaign=:l",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/push-rotate",
      "destination": "https://chesscoach-api-kbf8.onrender.com/api/push/rotate"
    },
    {
      "source": "/t/:path*",
      "destination": "https://chesscoach-api-kbf8.onrender.com/api/t/:path*"
    },
    {
      "source": "/challenge/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=challenge&code=:code"
    },
    {
      "source": "/share/:data",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=share&data=:data"
    },
    {
      "source": "/players",
      "destination": "/api/page?kind=players"
    },
    {
      "source": "/players/:slug",
      "destination": "/api/page?kind=player&slug=:slug"
    },
    {
      "source": "/learn",
      "destination": "/api/page?kind=learn"
    },
    {
      "source": "/learn/:slug",
      "destination": "/api/page?kind=article&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/tournaments/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=tournament&id=:id"
    },
    {
      "source": "/tournaments",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=tournaments"
    },
    {
      "source": "/beginner",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=beginner"
    },
    {
      "source": "/beginner/:unit/:lesson",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=beginner"
    },
    {
      "source": "/kids",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=kids"
    },
    {
      "source": "/kids/:world",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=kids"
    },
    {
      "source": "/kids/:world/:level",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|Bot|BOT|crawler|spider|facebookexternalhit|Facebot|WhatsApp|Slack|Discord|Telegram|Twitter|LinkedIn|Pinterest|Embedly|Iframely|Quora|Skype|redditbot|Applebot|vkShare|Google-PageRenderer|Snapchat|Viber|Line/|KakaoTalk|Mastodon|preview|Preview).*"
        }
      ],
      "destination": "/api/og?kind=page&p=kids"
    },
    {
      "source": "/pricing",
      "destination": "/api/page?kind=seo&key=pricing"
    },
    {
      "source": "/:key(play-chess-online|chess-for-kids|learn-chess|chess-puzzles|chess-tournaments|chess-game-analysis|scout-chess-opponent)",
      "destination": "/api/page?kind=seo&key=:key"
    },
    {
      "source": "/:lang(es|pt|fr|de|it|nl|pl|ru|uk|tr|ro|cs|hu|el|sv|ar|fa|hi|bn|id|vi|th|tl|zh-cn|zh-tw|ja|ko)",
      "destination": "/api/page?kind=seo&key=home&lang=:lang"
    },
    {
      "source": "/:lang(es|pt|fr|de|it|nl|pl|ru|uk|tr|ro|cs|hu|el|sv|ar|fa|hi|bn|id|vi|th|tl|zh-cn|zh-tw|ja|ko)/:key(play-chess-online|chess-for-kids|learn-chess|chess-puzzles|chess-tournaments|chess-game-analysis|scout-chess-opponent|pricing)",
      "destination": "/api/page?kind=seo&key=:key&lang=:lang"
    },
    {
      "source": "/vs/:name",
      "destination": "/api/page?kind=vs&path=/vs/:name"
    },
    {
      "source": "/chess-openings",
      "destination": "/api/page?kind=openings"
    },
    {
      "source": "/chess-openings/:slug",
      "destination": "/api/page?kind=opening&slug=:slug"
    },
    {
      "source": "/chess-traps",
      "destination": "/api/page?kind=traps"
    },
    {
      "source": "/chess-traps/:slug",
      "destination": "/api/page?kind=trap&slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
